# Build output and temporary work directories (generated, never commit)
build_dist/
build_pyinstaller/
build_cmake/
compiled/
releases/

# Publish scripts — require local developer credentials (GitHub CLI auth)
# Committing them serves no purpose: they are inert without authentication.
Publish_Release.*
Publish_Winget.*
build/Publish_Release.*
build/winget_update.*

# Dev-mode generated data (src/gen/ holds dev runtime data)
src/gen/

# Dev-mode runtime config (generated at startup — contains local paths)
src/Path/

# Runtime logs
*.log

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.ruff_cache/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Claude Code project context (developer-local)
DEVELOPMENT.md
.claude/

# Auto-generated version file (produced by CMake at build time)
src/_version.py
